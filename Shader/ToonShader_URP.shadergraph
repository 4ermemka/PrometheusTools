{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "cdef8c5f77624402b96bc8a47bd0ee2b",
    "m_Group": {
        "m_Id": "dc8ee18032464fd4b2d3f851d8b571b2"
    },
    "m_Name": "GetAllLightsDiffuse (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -2165.0,
            "y": -160.00001525878907,
            "width": 263.0,
            "height": 302.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "8987178914344942b5fcbf1275fc0dce"
        },
        {
            "m_Id": "4c9b563c123e4db9b971d9e5c07da70c"
        },
        {
            "m_Id": "750c8943d8714c799a737da6044eafdc"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 0,
    "m_FunctionName": "GetAllLightsDiffuse",
    "m_FunctionSource": "1561f85e210f8e74ab971763222e41c9",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "#ifndef CUSTOM_LIGHTING_HLSL\r\n#define CUSTOM_LIGHTING_HLSL\r\n\r\n#ifndef SHADERGRAPH_PREVIEW\r\n#include \"Packages/com.unity.render-pipelines.universal/ShaderLibrary/Lighting.hlsl\"\r\n#endif\r\n\r\nvoid CalculateCustomLighting_float(float3 worldPosition, float3 worldNormal, float3 albedo, out float3 outputColor)\r\n{\r\n    #ifdef SHADERGRAPH_PREVIEW\r\n        outputColor = albedo;\r\n    #else\r\n        outputColor = float3(0, 0, 0);\r\n\r\n        // --- 1. Ambient (фоновое) освещение ---\r\n        // Это добавляет базовое освещение сцены от всех источников.\r\n        outputColor += SampleSH(worldNormal) * albedo;\r\n\r\n        // --- 2. Main Light (основной источник) ---\r\n        Light mainLight = GetMainLight();\r\n        float3 mainLightColor = mainLight.color * mainLight.distanceAttenuation * mainLight.shadowAttenuation;\r\n        float mainDiffuse = saturate(dot(worldNormal, mainLight.direction));\r\n        outputColor += albedo * mainLightColor * mainDiffuse;\r\n\r\n        // --- 3. Additional Lights (дополнительные источники) ---\r\n        uint additionalLightsCount = GetAdditionalLightsCount();\r\n        for (uint lightIndex = 0; lightIndex < additionalLightsCount; lightIndex++)\r\n        {\r\n            Light additionalLight = GetAdditionalLight(lightIndex, worldPosition);\r\n            \r\n            float3 additionalLightColor = additionalLight.color * additionalLight.distanceAttenuation * additionalLight.shadowAttenuation;\r\n            float additionalDiffuse = saturate(dot(worldNormal, additionalLight.direction));\r\n            \r\n            outputColor += albedo * additionalLightColor * additionalDiffuse;\r\n        }\r\n    #endif\r\n}\r\n\r\n#endif"
}

